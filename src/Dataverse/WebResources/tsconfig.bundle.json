{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ES6",
    "moduleResolution": "Bundler",
    "outDir": "./src/templatepublisherprefix_templateprojectname/out",
    "sourceMap": true,
    "inlineSources": true
  },
  "include": [
    "./src/**/*.ts",
    "./typings/**/*.d.ts"
  ],
